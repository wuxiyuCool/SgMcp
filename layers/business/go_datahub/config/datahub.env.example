# go_datahub（Go 数据重活 server）独立配置入口（敏感）
# 用法：复制为同目录 config/datahub.env（已 .gitignore，不进版本库）。
# 优先级：命令行参数 > OS 环境变量 > 本文件；打包后改本文件重启 exe 即生效。
# 查找：exe/cwd 逐级向上找 config/datahub.env，或用 GO_DATAHUB_CONFIG 指定绝对路径。

# 服务监听（跨机部署用 0.0.0.0；默认 127.0.0.1:9300）
# GO_DATAHUB_ADDR=0.0.0.0
# GO_DATAHUB_PORT=9300

# Bearer 令牌：非空时所有请求必须带 Authorization: Bearer <token>
# 必须与网关机 config/platform.env 的 MCP_GODATAHUB_TOKEN 一致。
# 生成强随机串（PowerShell）：-join ((48..57)+(97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
# GO_DATAHUB_TOKEN=

# ── 数据库连接串注册表（DSN_<名称>=...）──────────────────────────
# MCP 工具参数用 dsn_ref="<名称>" 引用，密码只在服务器本地，不经聊天/网关/审计日志流转。
# 名称小写即可（读取时自动转大写匹配 DSN_<大写>）。
# DSN_ORDER_PG=postgres://user:pass@10.0.0.5:5432/orders?sslmode=disable
# DSN_ORDER_T1_PG=postgres://user:pass@10.0.0.6:5432/orders_t1?sslmode=disable
# DSN_WMS_MSSQL=sqlserver://user:pass@10.0.0.9:1433?database=wms
# DSN_ERP_ORACLE=oracle://user:pass@10.0.0.7:1521/orcl
# DSN_LOG_MYSQL=user:pass@tcp(10.0.0.8:3306)/logs?parseTime=true

# ── 业务数据集路由（DATASET_<名称>=...，data.query_dataset / itops.query_dataset 共用）──
# dataset_id 是业务名（不是表名）：route_db 按租户路由库，route_table 按月分表
# （orders + 2024-05 → 表 orders_202405）。值为 dsn_ref（引用上面的 DSN_<名称>）。
# _DOMAIN=域归属（第 2 层领域枚举按域限定；第 3 层全量枚举按域分组展示）
# _DESC=中文说明（工具枚举描述用，让 AI 看名知义）
# DATASET_ORDERS_DBTYPE=pg
# DATASET_ORDERS_DSN_T1=order_t1_pg        # 租户 t1 专属路由
# DATASET_ORDERS_DSN_DEFAULT=order_pg      # 未命中租户时的兜底
# DATASET_ORDERS_DOMAIN=order
# DATASET_ORDERS_DESC=订单数据（按月分表）
# DATASET_INCIDENTS_DBTYPE=pg
# DATASET_INCIDENTS_DSN_DEFAULT=itsm_pg    # 非周期数据集（固定表 incidents）
# DATASET_INCIDENTS_DOMAIN=itops
# DATASET_INCIDENTS_DESC=IT 运维事件单（工单流水）
# DATASET_ASSETS_DSN_DEFAULT=itsm_pg
# DATASET_ASSETS_DOMAIN=itops
# DATASET_ASSETS_DESC=CMDB 资产台账
