# Python 平台侧统一配置入口（敏感）
# 用法：复制为同目录 config/platform.env（该文件已被 .gitignore 排除，不进版本库）。
# 优先级：OS 环境变量 > 本文件；改完重启对应 server 即生效（无需重新打包/安装）。

# ---------------------------------------------------------------------------
# 网关聚合器（下游 server 注册表）
# ---------------------------------------------------------------------------
# 逗号分隔的 name=url。未设置时使用默认注册表：
#   it_ops=http://127.0.0.1:9200/mcp, common-tools=http://127.0.0.1:9100/mcp
#   + go_datahub（地址取下面的 MCP_GODATAHUB_URL）
# 新增业务 server 只需在这里追加，无需改网关代码：
# MCP_DOWNSTREAMS=it_ops=http://127.0.0.1:9200/mcp,common-tools=http://127.0.0.1:9100/mcp,finance=http://127.0.0.1:9400/mcp

# 下游鉴权：某个下游配了自己的 server token 时，网关按名字给它发 Bearer 头
# （不配则不带 Authorization；下游启用了鉴权而这里没配 → 聚合 401，list_downstreams 可见）
# MCP_DOWNSTREAM_TOKEN_ITOPS=<it_ops 侧 MCP_SERVER_TOKEN 同值>
# MCP_DOWNSTREAM_TOKEN_COMMON-TOOLS=<common 侧 MCP_SERVER_TOKEN 同值>

# 启动发现的重试窗口（秒）：下游未就绪时每秒重试，耗尽则跳过告警；
# 网关照常启动，可运行时调 refresh_routes 工具补拉工具表。0=只试一次。
# MCP_DISCOVERY_RETRY_SECONDS=6
# 单个下游 tools/list 发现的超时（秒）：下游半死时不拖住网关启动
# MCP_DISCOVERY_TIMEOUT_SECONDS=10

# 需要 HITL 审批的工具名（逗号分隔）。支持三种写法：
#   完整工具名 itops_create_change / 前缀通配 data_batch_* / server 限定 go_datahub:data_submit_collect_job
# 未设置时默认：itops_create_change, data_submit_collect_job
# MCP_APPROVAL_TOOLS=itops_create_change,data_submit_collect_job

# ---------------------------------------------------------------------------
# 安全开关（生产必配；ops-check 会在 describe_gateway 里回报是否已配）
# ---------------------------------------------------------------------------
# 【审批令牌】配了它，approve_request / reject_request / retry_execution 必须带
# approval_token 参数且值匹配才生效。令牌只发给人类审批人的独立客户端
# （运维机/审批机的环境变量），**绝不能出现在 AI 侧的 MCP 配置或对话里**——
# 不配则模型可以先挂单再自批，HITL 形同虚设。
# MCP_APPROVAL_TOKEN=<强随机串>

# 【网关 Bearer】非空则所有连网关的客户端必须带 Authorization: Bearer <token>。
# 未启用时任何能访问该端口的人都可调用全部下游工具。
# MCP_GATEWAY_TOKEN=

# 【下游业务层 Bearer】it_ops / common 等 Python server 各自的端口鉴权
# （Go 侧对应 GO_DATAHUB_TOKEN），配合上面的 MCP_DOWNSTREAM_TOKEN_* 使用。
# MCP_SERVER_TOKEN=

# 【限流】每客户端 IP 每秒请求数上限（0/不配=不限）。防 AI 平台重试风暴打穿下游
# MCP_RATE_LIMIT_PER_SECOND=20
# 可信反向代理 IP 或 CIDR（逗号分隔）：只有来自它们的请求才采信 X-Forwarded-For 分桶
# MCP_TRUSTED_PROXY=127.0.0.1,10.0.0.0/8

# 【超时与重试】下游工具调用整体超时（秒）；可按工具单独覆盖：
# MCP_DOWNSTREAM_TIMEOUT_SECONDS=60
# MCP_DOWNSTREAM_TIMEOUT_DATA_BATCH_IMPORT=300
# 只读工具的失败重试次数（写操作永不自动重试，避免重复落库）
# MCP_DOWNSTREAM_RETRIES=1

# ---------------------------------------------------------------------------
# 可观测与审计
# ---------------------------------------------------------------------------
# 审计与审批台账目录（默认 <项目根>/data/audit/，一行一个 JSON 事件，敏感键已遮蔽）
# MCP_AUDIT_DIR=/var/log/sgmcp/audit
# 关闭落盘（仅调试用；关掉即失去事后追溯能力）：MCP_AUDIT_PERSIST=0
# 审计文件轮转：单文件超过 MCP_AUDIT_MAX_BYTES 字节就轮转（.1/.2/…），保留 MCP_AUDIT_KEEP 份
# MCP_AUDIT_MAX_BYTES=20971520
# MCP_AUDIT_KEEP=3
# 慢调用告警阈值（毫秒）：MCP_AUDIT_SLOW_MS=3000
# 审批单超时自动关闭（分钟，0=不过期）：MCP_APPROVAL_TTL_MINUTES=240
# 等值请求去重窗口（秒，同一 server+工具+入参在窗口内只建一张单）：MCP_APPROVAL_DEDUPE_SECONDS=300
# 待办上限（超出按最旧撤销，防积压失控）：MCP_APPROVAL_MAX_PENDING=200
# 幂等键缓存有效期（秒，0=关闭 idempotency_key 能力）：MCP_IDEMPOTENCY_TTL_SECONDS=600
# 返回给 AI 的结果规模上限（条数 / 字符数）：MCP_MAX_RESULT_ITEMS=200、MCP_MAX_RESULT_CHARS=20000
# 运行时数据目录（SQLite / 审计 / 台账的根）：MCP_DATA_DIR=<项目根>/data

# ---------------------------------------------------------------------------
# go_datahub（Go 重活中层，兼容入口）
# ---------------------------------------------------------------------------
# 网关转发 go_datahub 的地址（跨机部署改为 http://<go主机IP>:9300/mcp）
MCP_GODATAHUB_URL=http://127.0.0.1:9300/mcp

# 网关→Go 的 Bearer 令牌。留空=不发送鉴权头（本机免鉴权场景）。
# 必须与 Go 侧 config/datahub.env 的 GO_DATAHUB_TOKEN 一致。
# MCP_GODATAHUB_TOKEN=

# ---------------------------------------------------------------------------
# 外部业务系统 API（business 工具的 api 通道，如事件单 channel=api）
# ---------------------------------------------------------------------------
# MCP_ITSM_API_URL=http://itsm.internal:8080
# MCP_ITSM_API_TOKEN=

# ---------------------------------------------------------------------------
# 业务数据集路由（Python 侧；Go 侧在 config/datahub.env 配同名键，两侧共用约定）
# _DOMAIN=域归属（领域枚举按域动态生成）、_DESC=中文说明（进工具参数描述）
# tenant_id 传 default 走 _DSN_DEFAULT 兜底路由（default 是各工具入参的默认值）
# DATASET_ORDERS_DBTYPE=pg
# DATASET_ORDERS_DSN_T1=order_t1_pg
# DATASET_ORDERS_DSN_DEFAULT=order_pg
# DATASET_ORDERS_DOMAIN=order
# DATASET_ORDERS_DESC=订单数据（按月分表）
# DATASET_INCIDENTS_DSN_DEFAULT=itsm_pg
# DATASET_INCIDENTS_DOMAIN=itops
# DATASET_INCIDENTS_DESC=IT 运维事件单（工单流水）
# DATASET_ASSETS_DSN_DEFAULT=itsm_pg
# DATASET_ASSETS_DOMAIN=itops
# DATASET_ASSETS_DESC=CMDB 资产台账

# ---------------------------------------------------------------------------
# 轻活层（common / business Python）的文件与规模护栏
# ---------------------------------------------------------------------------
# Python 侧文件类工具允许的根目录（逗号分隔）。不配 = 拒绝一切文件路径入参，
# 让 AI 改用直接传内容的工具。Go 侧对应 GO_DATAHUB_FILE_ROOTS。
# MCP_FILE_ROOTS=/data/exports,/tmp
# 单次处理文本长度上限：MCP_MAX_TEXT_CHARS=2000000
# 正则匹配文本/模式上限：MCP_MAX_REGEX_TEXT=500000、MCP_MAX_PATTERN_CHARS=500
# 列表类入参/返回条目上限：MCP_MAX_LIST_ITEMS=1000
