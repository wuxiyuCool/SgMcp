# Python 平台侧统一配置入口（敏感）
# 用法：复制为同目录 config/platform.env（该文件已被 .gitignore 排除，不进版本库）。
# 优先级：OS 环境变量 > 本文件；改完重启对应 server 即生效（无需重新打包/安装）。

# ---------------------------------------------------------------------------
# 网关聚合器（下游 server 注册表）
# ---------------------------------------------------------------------------
# 逗号分隔的 name=url。未设置时使用默认注册表：
#   it_ops=http://127.0.0.1:9200/mcp, common-tools=http://127.0.0.1:9100/mcp
#   + go_datahub（地址取下面的 MCP_GODATAHUB_URL）
# 新增业务 server 只需在这里追加，无需改网关代码：
# MCP_DOWNSTREAMS=it_ops=http://127.0.0.1:9200/mcp,common-tools=http://127.0.0.1:9100/mcp,finance=http://127.0.0.1:9400/mcp

# 启动发现的重试窗口（秒）：下游未就绪时每秒重试，耗尽则跳过告警；
# 网关照常启动，可运行时调 refresh_routes 工具补拉工具表。0=只试一次。
# MCP_DISCOVERY_RETRY_SECONDS=6

# 需要 HITL 审批的工具名（逗号分隔，完整工具名含层级前缀）。
# 未设置时默认：business.create_change,heavy.submit_collect_job
# MCP_APPROVAL_TOOLS=business.create_change,heavy.submit_collect_job

# ---------------------------------------------------------------------------
# go_datahub（Go 重活中层，兼容入口）
# ---------------------------------------------------------------------------
# 网关转发 go_datahub 的地址（跨机部署改为 http://<go主机IP>:9300/mcp）
MCP_GODATAHUB_URL=http://127.0.0.1:9300/mcp

# 网关→Go 的 Bearer 令牌。留空=不发送鉴权头（本机免鉴权场景）。
# 必须与 Go 侧 config/datahub.env 的 GO_DATAHUB_TOKEN 一致。
# MCP_GODATAHUB_TOKEN=

# ---------------------------------------------------------------------------
# 外部业务系统 API（business 工具的 api 通道，如事件单 channel=api）
# ---------------------------------------------------------------------------
# 外部 ITSM 系统 REST API 基址（如 http://itsm.internal:8080）。
# 未配置时 business.create_incident/list_incidents 的 channel=api 报可读错误。
# MCP_ITSM_API_URL=
# MCP_ITSM_API_TOKEN=

# ---------------------------------------------------------------------------
# 业务数据集路由（Python 侧；Go 侧在 config/datahub.env 配同名键，两侧共用约定）
# _DOMAIN=域归属（itops.query_dataset 等领域枚举按域限定）、_DESC=中文说明（枚举描述）
# DATASET_ORDERS_DBTYPE=pg
# DATASET_ORDERS_DSN_T1=order_t1_pg
# DATASET_ORDERS_DSN_DEFAULT=order_pg
# DATASET_ORDERS_DOMAIN=order
# DATASET_ORDERS_DESC=订单数据（按月分表）
# DATASET_INCIDENTS_DSN_DEFAULT=itsm_pg
# DATASET_INCIDENTS_DOMAIN=itops
# DATASET_INCIDENTS_DESC=IT 运维事件单（工单流水）
# DATASET_ASSETS_DSN_DEFAULT=itsm_pg
# DATASET_ASSETS_DOMAIN=itops
# DATASET_ASSETS_DESC=CMDB 资产台账
